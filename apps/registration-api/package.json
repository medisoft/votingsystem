{
  "name": "@voting/registration-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "test:integration": "vitest run --fileParallelism false test/auth.integration.test.ts test/audit.integration.test.ts",
    "audit:verify": "tsx src/audit-verify.ts",
    "audit:retain": "tsx src/audit-retain.ts",
    "db:grant-roles": "tsx src/grant-roles.ts",
    "issuer:generate": "tsx src/generate-issuer-rsa.ts"
  },
  "dependencies": {
    "@cloudflare/blindrsa-ts": "^0.4.6",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.5.0",
    "argon2": "^0.41.1",
    "csv-parse": "^7.0.1",
    "fast-uri": "^3.1.5",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.1",
    "find-my-way": "^9.9.0",
    "otpauth": "^9.5.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.22.0",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.8"
  }
}
